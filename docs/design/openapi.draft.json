  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["code", "message", "requestId"]
      },
      "Save": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "board": {
            "type": "array",
            "minItems": 4,
            "maxItems": 10,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 10,
              "items": {
                "type": "integer",
                "enum": [0, 1, 2]
              }
            }
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "errorCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["version", "board", "durationMs", "errorCount"]
      },
      "Start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["classic", "daily", "free"]
          },
          "contextId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["mode", "contextId"]
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["sessionId"]
      },
      "Restart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedAttempt": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["expectedAttempt"]
      },
      "GenericResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "requestId": {
            "type": "string"
          }
        },
        "required": ["requestId"]
      }
    }
  }
}
